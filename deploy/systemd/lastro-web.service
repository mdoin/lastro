# Lastro — web app (API + frontend). Escuta só em loopback; o Caddy do host faz o HTTPS.
[Unit]
Description=Lastro - web app
After=network-online.target lastro-mentor.service
Wants=network-online.target

[Service]
User=patrimonio
Group=patrimonio
SupplementaryGroups=lastro-sock
Environment=LASTRO_DB=/var/lib/patrimonio/lastro.db
Environment=LASTRO_MENTOR_SOCKET=/run/lastro-mentor/mentor.sock
Environment=LASTRO_STATIC_DIR=/opt/meu-patrimonio/frontend/dist
Environment=LASTRO_HOST=127.0.0.1
Environment=LASTRO_PORT=8080
Environment=LASTRO_TRUSTED_PROXIES=127.0.0.1
WorkingDirectory=/opt/meu-patrimonio/backend
ExecStart=/opt/meu-patrimonio/.venv/bin/python -m app.web
Restart=on-failure
RestartSec=5

IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/patrimonio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
