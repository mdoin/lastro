# Lastro — controlador dos computadores dos agentes (docs/COMPUTADORES.md). Root porque fala com o Docker;
# só aceita pedidos pelo socket 0660 root:lastro-sock (web e worker do mentor).
[Unit]
Description=Lastro - computadores dos agentes
After=docker.service
Requires=docker.service

[Service]
Environment=LASTRO_PC_SOCKET=/run/lastro-computadores/controle.sock
Environment=LASTRO_SOCKET_GROUP=lastro-sock
Environment=LASTRO_PC_MAX=3
ExecStart=/usr/bin/python3 /opt/meu-patrimonio/deploy/computador/controle.py
RuntimeDirectory=lastro-computadores
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
