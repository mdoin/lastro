# Copie para .env (que está no .gitignore) e preencha localmente. Nunca cole valores em prompts.
# Token aleatório (>= 32 caracteres) exigido pela API de leitura dos agentes.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MPA_AGENT_API_TOKEN=
# Diretório de dados servido aos agentes. Na Fase 0/1 só aceita arquivos marcados como sintéticos.
MPA_DATA_DIR=
