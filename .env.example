# Lastro — configuração da instalação (Docker Compose).
# Gere o .env com:  scripts/init-env.sh   (copia este arquivo e preenche os segredos com valores aleatórios)
# O .env fica fora do Git. Nunca cole chaves de IA aqui: conecte provedores pela interface (Configurações).

# --- Obrigatório -------------------------------------------------------------------------------------------
# Token entre o worker dos agentes e a API de leitura do banco (>= 32 caracteres aleatórios).
LASTRO_AGENT_API_TOKEN=

# --- Rede e acesso -----------------------------------------------------------------------------------------
# Onde publicar o web. 127.0.0.1 = só nesta máquina (use o perfil https ou um túnel para acesso externo).
LASTRO_BIND=127.0.0.1
LASTRO_HTTP_PORT=8080
# Cookie só por HTTPS. Deixe 1; use 0 apenas para acessar por http:// fora de localhost numa rede confiável.
LASTRO_COOKIE_SECURE=1
# HTTPS automático (perfil "https"): domínio que aponta para este servidor.
LASTRO_DOMAIN=
# Proxies cujo X-Forwarded-For é aceito (o caddy do perfil https tem IP fixo 172.31.250.10).
LASTRO_TRUSTED_PROXIES=127.0.0.1,172.31.250.10

# --- Região ------------------------------------------------------------------------------------------------
LASTRO_TZ=America/Sao_Paulo

# --- Primeira senha ----------------------------------------------------------------------------------------
# Opcional. Vazio = o web gera um token em /data/setup-token na primeira subida (leia no servidor).
LASTRO_SETUP_TOKEN=

# --- Executáveis oficiais opcionais (entram na imagem só se = 1) -------------------------------------------
# Claude Code: CLI oficial da Anthropic (termos próprios; leia docs/PROVIDER_TERMS.md).
LASTRO_WITH_CLAUDE_CODE=0
# Codex: CLI oficial da OpenAI (login com a conta do ChatGPT por device code). Integração experimental.
LASTRO_WITH_CODEX=0

# --- Capacidade --------------------------------------------------------------------------------------------
LASTRO_MENTOR_CONCURRENCY=3
LASTRO_RUN_CONCURRENCY=2

# --- Dados externos ----------------------------------------------------------------------------------------
# Opcional: séries do FRED (juros dos EUA). Chave gratuita em https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Código-fonte (AGPL-3.0 §13) --------------------------------------------------------------------------
# Link mostrado no login e nas Configurações. Se você modificar o Lastro e oferecê-lo pela rede a outras pessoas,
# aponte para o código-fonte da SUA versão.
LASTRO_SOURCE_URL=

# --- Versão da imagem local --------------------------------------------------------------------------------
LASTRO_VERSION=local
